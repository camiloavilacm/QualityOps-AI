{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualityops:evidence:2.0.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "collected_at",
    "source",
    "expected",
    "observed",
    "completeness",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0-draft.1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "revision",
        "run_id",
        "adapter_version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "recorded",
            "synthetic"
          ]
        },
        "repository": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "recorded"
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      }
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "test_id",
          "slot",
          "requirement_ids"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "test_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "slot": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "observed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "outcome",
          "observation",
          "artifact_ids"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "error",
              "missing"
            ]
          },
          "observation": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "error"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "error"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "kind",
          "source_path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "path": {
            "type": "string",
            "pattern": "^artifacts/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "requirement",
              "execution-report",
              "diagnostic"
            ]
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
