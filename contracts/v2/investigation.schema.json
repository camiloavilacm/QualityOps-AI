{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualityops:investigation:2.0.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "evidence_sha256",
    "investigation_id",
    "fixture_or_run_id",
    "status",
    "category",
    "claims",
    "uncertainties",
    "model_id",
    "prompt_sha256",
    "tool_contract_version",
    "parameters",
    "usage",
    "estimated_cost_usd",
    "latency_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0-draft.1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "fixture_or_run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "status": {
      "enum": [
        "DIAGNOSED",
        "INCONCLUSIVE",
        "ERROR"
      ]
    },
    "category": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "evidence_ids"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_contract_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "max_tokens"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "estimated_cost_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "DIAGNOSED"
      }
    }
  },
  "then": {
    "properties": {
      "category": {
        "type": "string"
      },
      "claims": {
        "minItems": 1
      }
    }
  },
  "else": {
    "properties": {
      "category": {
        "type": "null"
      },
      "claims": {
        "maxItems": 0
      },
      "uncertainties": {
        "minItems": 1
      }
    }
  }
}
