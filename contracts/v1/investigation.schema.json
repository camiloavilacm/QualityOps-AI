{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualityops:investigation:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "manifest_sha256",
    "status",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "available",
        "insufficient-evidence",
        "unavailable"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis",
          "artifact_ids"
        ],
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
